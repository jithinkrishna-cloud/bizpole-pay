# Database (Neon). `neon env pull` writes both into .env.local.
# Pooled endpoint (-pooler) for the app; direct endpoint for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# App
APP_URL="http://localhost:3000"
# 32-byte base64 key used to encrypt PAN, PayU salts, bank numbers, webhook secrets.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY="base64:..."

# PayU — TEST (from Dashboard → Test Mode → Developer). Never commit real values.
# Optional: if all three are set, the first merchant to sign up gets this test credential.
# Otherwise each merchant adds their own in Developer.
PAYU_TEST_MID=""
PAYU_TEST_KEY=""
PAYU_TEST_SALT=""
PAYU_TEST_PAYMENT_URL="https://test.payu.in/_payment"
PAYU_TEST_POSTSERVICE_URL="https://test.payu.in/merchant/postservice.php?form=2"

# PayU — LIVE (after onboarding is approved)
PAYU_LIVE_PAYMENT_URL="https://secure.payu.in/_payment"
PAYU_LIVE_POSTSERVICE_URL="https://info.payu.in/merchant/postservice.php?form=2"

# PayU partner / OAuth (issued by PayU when your partner account is approved)
PAYU_PARTNER_CLIENT_ID=""
PAYU_PARTNER_CLIENT_SECRET=""
PAYU_OAUTH_URL="https://accounts.payu.in/oauth/token"
